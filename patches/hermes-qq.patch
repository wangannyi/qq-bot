+    def _is_bot_mentioned(self, d: Dict[str, Any], content: str) -> bool:
+        """Return whether a full-group event explicitly targets this bot.
+
+        ``GROUP_MESSAGE_CREATE`` carries a ``mentions`` list and removes the
+        textual @ prefix.  Compare OpenIDs first; the app ID and username are
+        conservative compatibility fallbacks for older payload variants.
+        """
+        target_ids = {
+            value.casefold()
+            for value in (self._bot_user_id, self._app_id)
+            if value
+        }
+        target_username = self._bot_username.casefold()
+        mentions = d.get("mentions")
+        if isinstance(mentions, list):
+            for mention in mentions:
+                if not isinstance(mention, dict):
+                    continue
+                mention_ids = {
+                    str(mention.get(key, "")).strip().casefold()
+                    for key in ("id", "user_openid", "member_openid")
+                }
+                if target_ids.intersection(mention_ids):
+                    return True
+                if (
+                    target_username
+                    and bool(mention.get("bot"))
+                    and str(mention.get("username", "")).strip().casefold()
+                    == target_username
+                ):
+                    return True
+
+        # Some old clients send a literal mention but omit structured mentions.
+        # Require an explicit @ so ordinary discussion of the bot's name never
+        # turns into an unsolicited response.
+        normalized_content = str(content or "").casefold()
+        return any(
+            f"@{identifier.casefold()}" in normalized_content
+            for identifier in (self._bot_username, self._app_id)
+            if identifier
+        )
