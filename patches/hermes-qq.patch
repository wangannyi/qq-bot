+import re
+from unittest.mock import AsyncMock
+from urllib.parse import unquote
+
+import pytest
+from gateway.config import PlatformConfig
+from gateway.platforms.qqbot import QQAdapter
+from gateway.platforms.qqbot.mobile_format import (
+    format_qq_markdown,
+    mobile_markdown,
+    wire_url,
+)
+
+
+def adapter(**extras):
+    return QQAdapter(PlatformConfig(enabled=True, extra={"app_id": "test", "client_secret": "test", **extras}))
+
+
+def test_unicode_link_is_named_encoded_and_idempotent():
+    url = "https://www.spacemit.com/community/document/info?lang=zh&nodepath=competition/竞赛教程/a_b.md"
+    result = mobile_markdown(f"[开发者文档]({url})")
+    assert result.startswith("[🔗开发者文档](https://")
+    assert "竞赛" not in result and "%E7" in result
+    assert unquote(result.split("](")[1][:-1]) == url
+    assert mobile_markdown(result) == result
+
+
+def test_query_delimiters_and_existing_escapes_preserved():
+    url = "https://www.spacemit.com/community/info?a=x%26y&nodepath=路径/a%20b.md"
+    result = wire_url(url)
+    assert "x%26y&nodepath=" in result
+    assert "%2526" not in result
+
+
+def test_plain_steps_no_fragmented_inline_blocks():
+    result = mobile_markdown("## 解决方式\n\n1. 运行 `ollama list`。\n2. 查看文档。")
+    assert "1、运行 ollama list。" in result
+    assert "`" not in result and "##" not in result
+
+
+def test_complex_code_not_corrupted_into_a_partial_command():
+    result = mobile_markdown("```python\n# comment\nfor i in range(3):\n    print(i)\n```\n[说明](https://www.spacemit.com/community)")
+    assert "print(i)" not in result
+    assert "多行代码请查看文档" in result
+    assert "[🔗说明]" in result
+
+
+def test_truncated_code_is_not_sent_as_an_executable_fragment():
+    result = mobile_markdown("步骤\n```sh\nsudo apt install unfinished")
+    assert "```" not in result and "sudo apt" not in result
+    assert "代码不完整" in result
+
+
+@pytest.mark.asyncio
+async def test_standalone_send_uses_same_format(monkeypatch):
+    import httpx
+    from tools.send_message_tool import _send_qqbot
+    from types import SimpleNamespace
+    sent = []
+    class Client:
+        def __init__(self, **kwargs):
+            pass
+        async def __aenter__(self):
+            return self
+        async def __aexit__(self, *args):
+            pass
+        async def post(self, url, **kwargs):
+            if "getAppAccessToken" in url:
+                return httpx.Response(200, json={"access_token": "test"})
+            sent.append(kwargs["json"])
+            return httpx.Response(200, json={"id": "test"})
+    monkeypatch.setattr(httpx, "AsyncClient", Client)
+    cfg = SimpleNamespace(extra={"app_id":"test", "client_secret":"test", "compact_mobile":True}, token="")
+    message = "[文档](https://www.spacemit.com/community)"
+    result = await _send_qqbot(cfg, "test", message)
+    assert result["success"]
+    assert sent[0]["markdown"]["content"] == mobile_markdown(message)
+
+
+@pytest.mark.asyncio
+async def test_standalone_rich_markdown_keeps_supported_format_and_headers(monkeypatch):
+    import httpx
+    from tools.send_message_tool import _send_qqbot
+    from types import SimpleNamespace
+
+    sent = []
+
+    class Client:
+        def __init__(self, **kwargs):
+            pass
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *args):
+            pass
+
+        async def post(self, url, **kwargs):
+            if "getAppAccessToken" in url:
+                return httpx.Response(200, json={"access_token": "test"})
+            sent.append(kwargs)
+            return httpx.Response(200, json={"id": "test"})
+
+    monkeypatch.setattr(httpx, "AsyncClient", Client)
+    cfg = SimpleNamespace(
+        extra={"app_id": "test", "client_secret": "test", "compact_mobile": False},
+        token="",
+    )
+    message = "## 🧪 标题\n\n**结论**\n\n1. 第一步"
+    result = await _send_qqbot(cfg, "test", message)
+
+    assert result["success"]
+    assert sent[0]["json"]["markdown"]["content"] == format_qq_markdown(message)
+    assert sent[0]["headers"]["Accept"] == "application/json"
+    assert sent[0]["headers"]["User-Agent"].startswith("QQBotAdapter/")
+
+
+def test_default_workflow_unchanged():
+    a = adapter()
+    assert a.format_message("`echo hi`") == "`echo hi`"
+    assert a.format_message("[说明](https://www.spacemit.com/community)").startswith("[说明]")
+
+
+def test_rich_formatter_is_shared_and_preserves_supported_markdown():
+    content = "**结论**\n步骤如下：\n1. **第一项**\n> ⚠️ 注意事项"
+    expected = "## 结论\n步骤如下：\n\n1. **第一项**\n> ⚠️ 注意事项"
+
+    assert format_qq_markdown(content) == expected
+    assert adapter(compact_mobile=False).format_message(content) == expected
+
+
+@pytest.mark.asyncio
+async def test_actual_gateway_send_uses_mobile_formatter():
+    a = adapter(compact_mobile=True)
+    a._connected = True
+    a._wait_for_reconnection = AsyncMock(return_value=True)
+    from gateway.platforms.base import SendResult
+    a._send_chunk = AsyncMock(return_value=SendResult(success=True))
+    result = await a.send("test", "1. 运行 `ollama list`。\n[文档](https://www.spacemit.com/community)")
+    assert result.success
+    text = a._send_chunk.call_args.args[1]
+    assert text.startswith("1、") and "[🔗文档]" in text
+    payload = a._build_text_body(text, None)
+    assert payload["msg_type"] == 2
+    assert payload["markdown"]["content"] == text
