+    def _gateway_health(self) -> dict:
+        """Bounded transport diagnostics, without message text or credentials."""
+        now = time.monotonic()
+
+        def age(stamp):
+            return round(max(0.0, now - stamp), 1) if stamp else None
+
+        return {
+            "frame_age": age(self._last_gateway_frame_at),
+            "heartbeat_sent_age": age(self._last_heartbeat_sent_at),
+            "heartbeat_ack_age": age(self._last_heartbeat_ack_at),
+            "heartbeat_send_failures": self._heartbeat_send_failures,
+            "heartbeat_interval": self._heartbeat_interval,
