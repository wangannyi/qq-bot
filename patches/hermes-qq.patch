+    async def _supervisor_loop(self) -> None:
+        """Repair silently-dead receive/heartbeat tasks and stale sockets.
+
+        A transport can remain TCP-established after its receive task has
+        exited, leaving QQ events queued in the kernel while the runtime still
+        reports the adapter as connected. Gateway heartbeats provide regular
+        inbound ACK frames, so a long frame silence is also a reliable signal
+        that the socket needs to be replaced.
+        """
+        try:
+            while self._running:
+                await asyncio.sleep(self._SUPERVISOR_INTERVAL_SECONDS)
+                if not self._running:
+                    return
+
+                if self._listen_task is None or self._listen_task.done():
+                    failure = None
+                    if self._listen_task is not None and not self._listen_task.cancelled():
+                        try:
+                            failure = self._listen_task.exception()
+                        except Exception as exc:
+                            failure = exc
+                    logger.warning(
+                        "[%s] Receive task stopped unexpectedly%s; restarting it",
+                        self._log_tag,
+                        f": {failure}" if failure else "",
+                    )
+                    self._listen_task = asyncio.create_task(self._listen_loop())
+
+                if self._heartbeat_task is None or self._heartbeat_task.done():
+                    logger.warning(
+                        "[%s] Heartbeat task stopped unexpectedly; restarting it",
+                        self._log_tag,
+                    )
+                    self._heartbeat_task = asyncio.create_task(self._heartbeat_loop())
+
+                stale_after = max(
+                    self._STALE_GATEWAY_MIN_SECONDS,
+                    self._heartbeat_interval * 3,
+                )
+                silence = time.monotonic() - self._last_gateway_frame_at
+                if (
+                    self._ws
+                    and not self._ws.closed
+                    and self._last_gateway_frame_at > 0
+                    and silence > stale_after
+                ):
+                    logger.warning(
+                        "[%s] No gateway frame for %.1fs; forcing reconnect; health=%s",
+                        self._log_tag,
+                        silence,
+                        self._gateway_health(),
+                    )
+                    self._last_gateway_frame_at = time.monotonic()
+                    await self._ws.close()
+        except asyncio.CancelledError:
+            pass
