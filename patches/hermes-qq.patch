+            headers.update(get_api_headers())
+            # Keep standalone sends consistent with the live QQ gateway.  QQ
+            # only parses links such as ``[label](url)`` when the message is
+            # sent as custom Markdown (msg_type=2); sending the same content as
+            # plain text leaves the Markdown source visible in the client.
+            if bool(extra.get("markdown_support", True)):
+                # ``_send_qqbot`` can also be called directly in tooling and
+                # tests, so apply the same idempotent formatter here as a
+                # final safeguard.  The normal router formats beforehand.
+                from gateway.platforms.qqbot.mobile_format import format_qq_markdown
+                message = format_qq_markdown(
+                    message,
+                    compact_mobile=bool(extra.get("compact_mobile", False)),
+                )
+                payload = {
+                    "markdown": {"content": message[:4000]},
+                    "msg_type": 2,
+                    # Match the live gateway payload. QQ uses this sequence to
+                    # identify a concrete outbound message and de-duplicate
+                    # retries; omitting it can make custom message fields fall
+                    # back to plain-text handling on some C2C paths.
+                    "msg_seq": int(time.time() * 1000) % 65536,
+                }
+            else:
+                payload = {
+                    "content": message[:4000],
+                    "msg_type": 0,
+                    "msg_seq": int(time.time() * 1000) % 65536,
+                }
 
             # Try channel endpoint first (works for guild channels)
             url = f"https://api.sgroup.qq.com/channels/{chat_id}/messages"
