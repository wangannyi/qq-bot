+    def test_read_events_raises_immediately_when_ws_is_closing(self):
+        """CLOSING is a terminal gateway state, not a frame to ignore.
+
+        If it were ignored, _read_events would keep awaiting the same socket
+        and delay the reconnect loop.  The second receive deliberately fails
+        so this also proves the first CLOSING frame took the exception path.
+        """
+        import aiohttp
+        from gateway.platforms.qqbot.adapter import QQCloseError
+
+        adapter = self._make_adapter()
+        adapter._running = True
+
+        class ClosingWebSocket:
+            closed = False
+
+            def __init__(self):
+                self.receive_calls = 0
+
+            async def receive(self):
+                self.receive_calls += 1
+                if self.receive_calls == 1:
+                    return SimpleNamespace(
+                        type=aiohttp.WSMsgType.CLOSING,
+                        data=None,
+                        extra="gateway closing",
+                    )
+                raise AssertionError("CLOSING frame must trigger reconnect before another receive")
+
+        ws = ClosingWebSocket()
+        adapter._ws = ws
+
+        with pytest.raises((RuntimeError, QQCloseError)):
+            asyncio.run(adapter._read_events())
+        assert ws.receive_calls == 1
