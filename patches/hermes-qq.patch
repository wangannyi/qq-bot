+def _rewrite_plain_summary_command(content: str) -> str:
+    """Map natural-language daily-summary requests to the local quick command."""
+    normalized = re.sub(r"[\s，。！？!?、,.：:；;~～]+$", "", content.strip())
+    compact = re.sub(r"\s+", "", normalized)
+    is_fuzzy_summary = (
+        len(compact) <= 12
+        and ("今日" in compact or "今天" in compact)
+        and "汇总" in compact
+        and "问" in compact
+        and "题" in compact
+    )
+    return (
+        "/daily"
+        if normalized in _DAILY_SUMMARY_TRIGGERS or is_fuzzy_summary
+        else content
+    )
+
