+"""QQ Custom Markdown formatting helpers.
+
+``mobile_markdown`` is the legacy compact fallback for older clients.  The
+normal path uses ``normalize_qq_markdown`` instead, because current QQ C2C
+and group Custom Markdown supports headings, emphasis, lists and blockquotes.
+Keeping both formatters here makes live replies and standalone sends use the
+same formatting policy.
+"""
+import html
+import re
+from urllib.parse import quote, urlsplit, urlunsplit
+
+LINK = re.compile(r"(?<!!)\[([^\]\n]+)\]\((https?://[^\s<>]+)\)")
+
+
+def normalize_qq_markdown(content: str) -> str:
+    """Normalize model Markdown to the subset rendered reliably by QQ.
+
+    QQ expects a blank line before a list following normal prose.  Standalone
+    bold labels become short level-two headings and the support bot's two
+    escalation bullets become a numbered list.  This function deliberately
+    preserves supported Markdown rather than flattening it for mobile.
+    """
+    normalized: list[str] = []
+    escalation_number = {"已确认": 1, "待确认": 2}
+
+    for raw_line in str(content or "").splitlines():
+        line = raw_line.rstrip()
+        heading = re.fullmatch(r"\s*\*\*(.+?)\*\*\s*", line)
+        if heading:
+            line = f"## {heading.group(1).strip()}"
+
+        escalation = re.fullmatch(
+            r"\s*[-+*]\s*(已确认|待确认)\s*[：:]\s*(.*)", line
+        )
+        if escalation:
+            label, detail = escalation.groups()
+            line = f"{escalation_number[label]}. {label}：{detail.strip()}"
+
+        is_list_item = bool(re.match(r"\s*(?:[-+*]|\d+[.)])\s+", line))
+        previous = normalized[-1] if normalized else ""
+        previous_is_list = bool(
+            re.match(r"\s*(?:[-+*]|\d+[.)])\s+", previous)
+        )
+        if is_list_item and previous and not previous_is_list:
+            normalized.append("")
+        normalized.append(line)
+
+    return "\n".join(normalized)
+
+
+def format_qq_markdown(content: str, *, compact_mobile: bool = False) -> str:
+    """Apply the configured QQ presentation policy in one shared place."""
+    if compact_mobile:
+        return mobile_markdown(content)
+    return normalize_qq_markdown(content)
+
+
+def wire_url(url: str) -> str:
+    parts = urlsplit(html.unescape(url))
+    return urlunsplit((parts.scheme, parts.netloc.encode("idna").decode(),
+                       quote(parts.path, safe="/%:@-._~!$&'*+,;="),
+                       quote(parts.query, safe="%=&?/:@,+-._~!$'*;"),
+                       quote(parts.fragment, safe="%-._~")))
+
+
+def mobile_markdown(content: str) -> str:
+    saved: list[str] = []
+
+    def keep(value):
+        saved.append(value)
+        return f"\x00QQ{len(saved)-1}\x00"
+
+    def link(match):
+        label = re.sub(r"^[🔗\s]+", "", match[1]).strip()
+        label = re.sub(r"[*`_]+", "", label)
+        return keep(f"[🔗{label}]({wire_url(match[2])})")
+
+    # Protect code BEFORE matching links/Markdown inside it.
+    def code(match):
+        code_text = match[2].strip("\n")
+        if "\n" not in code_text and len(code_text) <= 180 and not any(c in code_text for c in "`*_[]<>\\"):
+            return keep(code_text)
+        return keep("（多行代码请查看文档；手机消息中不展开，避免复制不完整。）")
+
+    text = re.sub(r"(`{3,}|~{3,})[^\n]*\n(.*?)\n\1", code, str(content or ""), flags=re.S)
+    # A model cut off mid-fence must not send a half-command to a student.
+    text = re.sub(r"(?ms)^[ \t]*(?:`{3,}|~{3,}).*\Z", "（代码不完整，请查看文档或补充问题后再确认。）", text)
+    text = LINK.sub(link, text)
+    text = re.sub(r"`([^`\n]+)`", lambda m: keep(html.escape(m[1], quote=False)), text)
+    text = re.sub(r"(?m)^\s*#{1,6}\s+", "", text)
+    text = re.sub(r"\*\*(.+?)\*\*", r"\1", text)
+    # Plain numbering is visible even on clients without Markdown list support.
+    text = re.sub(r"(?m)^\s*(\d+)[.)]\s+", r"\1、", text)
+    text = re.sub(r"(?m)^\s*[-+*]\s+", "• ", text)
+    text = re.sub(r"(?m)^\s*>\s?", "", text)
+    text = re.sub(r"\n{3,}", "\n\n", text).strip()
+    for i, value in enumerate(saved):
+        text = text.replace(f"\x00QQ{i}\x00", value)
+    return text
